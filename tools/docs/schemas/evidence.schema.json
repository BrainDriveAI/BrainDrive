{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://braindrive.ai/schemas/developer-docs-evidence-v1.json",
  "title": "Sanitized developer documentation evidence",
  "type": "object",
  "required": ["schemaVersion", "kind", "id", "revision", "branchOrTag", "environment", "startState", "command", "workingDirectory", "toolVersions", "steps", "expected", "actual", "interventions", "confusionPoints", "cleanup", "remainingRisk", "disposition", "sanitization"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "enum": ["journey", "human-review", "ai-agent-scorecard"] },
    "id": { "type": "string" }, "revision": { "type": "string" }, "branchOrTag": { "type": "string" },
    "environment": { "type": "string" }, "startState": { "type": "string" }, "command": { "type": "string" }, "workingDirectory": { "type": "string" }, "toolVersions": { "type": "string" },
    "steps": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "expected": { "type": "string" }, "actual": { "type": "string" },
    "interventions": { "type": "array" }, "confusionPoints": { "type": "array" }, "cleanup": { "type": "string" }, "remainingRisk": { "type": "string" },
    "disposition": { "enum": ["pass", "fail", "blocked"] }, "sanitization": { "type": "string" }
  }
}
