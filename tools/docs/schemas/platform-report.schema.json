{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://braindrive.ai/schemas/developer-docs-platform-report-v1.json",
  "title": "Sanitized native J-05 platform report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "journeyId", "platform", "environment", "sourceTestRevision", "sourceCandidateProof", "cleanBefore", "cleanAfter", "toolVersions", "commands", "dynamicGatewayObservation", "providerIndependentUsableShellBaseline", "cleanup", "sanitization", "operatorRole", "reviewerRole", "remainingRisk", "disposition"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "journeyId": { "const": "J-05" },
    "platform": { "enum": ["windows", "macos"] },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "osName", "osVersion", "architecture"],
      "properties": {
        "kind": { "const": "native" },
        "osName": { "type": "string", "minLength": 1 },
        "osVersion": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 }
      }
    },
    "sourceTestRevision": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "sourceCandidateProof": { "type": "string", "pattern": "^source-candidate sha256 [0-9a-f]{64}; entries [0-9]+; revision [0-9a-f]{40}$" },
    "cleanBefore": { "const": true },
    "cleanAfter": { "const": true },
    "toolVersions": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "minLength": 1 } },
    "commands": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/commandResult" } },
    "dynamicGatewayObservation": { "$ref": "#/$defs/passingObservation" },
    "providerIndependentUsableShellBaseline": { "$ref": "#/$defs/passingObservation" },
    "cleanup": { "type": "string", "minLength": 1 },
    "sanitization": { "const": "pass" },
    "operatorRole": { "type": "string", "minLength": 1 },
    "reviewerRole": { "type": "string", "minLength": 1 },
    "remainingRisk": { "type": "string", "minLength": 1 },
    "disposition": { "const": "pass" }
  },
  "$defs": {
    "commandResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "workingDirectory", "exitCode", "result", "summary"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "workingDirectory": { "type": "string", "minLength": 1 },
        "exitCode": { "const": 0 },
        "result": { "const": "pass" },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "passingObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "summary"],
      "properties": {
        "result": { "const": "pass" },
        "summary": { "type": "string", "minLength": 1 }
      }
    }
  }
}
