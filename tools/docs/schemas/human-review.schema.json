{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://braindrive.ai/schemas/developer-docs-human-review-v1.json",
  "title": "Sanitized attributable human review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reviewId", "reviewerRole", "operatorRole", "reviewDate", "sourceTestRevision", "sourceCandidateProof", "scope", "reviewedSources", "findings", "independence", "sanitization", "remainingRisk", "disposition"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "reviewId": { "type": "string", "pattern": "^REV-0[1-8]$" },
    "reviewerRole": { "type": "string", "minLength": 1 },
    "operatorRole": { "type": "string", "minLength": 1 },
    "reviewDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "sourceTestRevision": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "sourceCandidateProof": { "type": "string", "pattern": "^source-candidate sha256 [0-9a-f]{64}; entries [0-9]+; revision [0-9a-f]{40}$" },
    "scope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "reviewedSources": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "independence": { "type": "string", "minLength": 1 },
    "sanitization": { "const": "pass" },
    "remainingRisk": { "type": "string", "minLength": 1 },
    "disposition": { "const": "pass" }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "summary", "evidencePath", "disposition"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["low", "medium", "high", "critical"] },
        "summary": { "type": "string", "minLength": 1 },
        "evidencePath": { "type": "string", "minLength": 1 },
        "disposition": { "enum": ["resolved", "open", "blocked"] }
      }
    }
  }
}
