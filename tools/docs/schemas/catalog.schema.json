{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://braindrive.ai/schemas/developer-docs-catalog-v1.json",
  "title": "BrainDrive developer documentation catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "authority", "agentContract", "ownerRoles", "audiences", "journeys", "components", "platformClaims", "topics", "topicBindings", "documents", "governanceSurfaces", "commands", "sourceMappings", "aliases", "versionDomains", "migrationPolicies", "deprecations", "searchVocabulary", "openItems"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "authority": { "const": "catalog" },
    "catalogPurpose": { "type": "string", "minLength": 1 },
    "agentContract": { "$ref": "#/$defs/agentContract" },
    "ownerRoles": { "type": "array", "items": { "$ref": "#/$defs/ownerRole" } },
    "audiences": { "type": "array", "items": { "$ref": "#/$defs/route" } },
    "journeys": { "type": "array", "items": { "$ref": "#/$defs/route" } },
    "components": { "type": "array", "items": { "$ref": "#/$defs/route" } },
    "platformClaims": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/platformClaim" } },
    "topics": { "type": "array", "items": { "$ref": "#/$defs/topic" } },
    "topicBindings": { "type": "array", "items": { "$ref": "#/$defs/topicBinding" } },
    "documents": { "type": "array", "items": { "$ref": "#/$defs/document" } },
    "governanceSurfaces": { "type": "array", "items": { "$ref": "#/$defs/document" } },
    "commands": { "type": "array", "items": { "$ref": "#/$defs/command" } },
    "sourceMappings": { "type": "array", "items": { "$ref": "#/$defs/sourceMapping" } },
    "aliases": { "type": "array", "items": { "$ref": "#/$defs/alias" } },
    "versionDomains": { "type": "array", "items": { "$ref": "#/$defs/versionDomain" } },
    "migrationPolicies": { "type": "array", "items": { "$ref": "#/$defs/migrationPolicy" } },
    "deprecations": { "type": "array", "items": { "$ref": "#/$defs/deprecation" } },
    "searchVocabulary": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "openItems": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/openItem" } }
  },
  "$defs": {
    "agentContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["governingInstructions", "compatibilityMirrors", "artifactClasses", "taskRoutes", "changeRoutes", "checkRoutes", "pairedChangeObligations", "restrictedExclusions"],
      "properties": {
        "governingInstructions": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/agentInstruction" } },
        "compatibilityMirrors": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/agentMirror" } },
        "artifactClasses": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifactClass" } },
        "taskRoutes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/taskRoute" } },
        "changeRoutes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/changeRoute" } },
        "checkRoutes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/checkRoute" } },
        "pairedChangeObligations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/pairedChange" } },
        "restrictedExclusions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/restrictedExclusion" } }
      }
    },
    "agentInstruction": { "type": "object", "additionalProperties": false, "required": ["path", "scope", "kind", "precedence"], "properties": { "path": { "type": "string" }, "scope": { "type": "string" }, "kind": { "enum": ["canonical-root", "additive-scoped"] }, "precedence": { "type": "integer", "minimum": 1 } } },
    "agentMirror": { "type": "object", "additionalProperties": false, "required": ["path", "canonicalPath", "kind", "independentAuthority"], "properties": { "path": { "type": "string" }, "canonicalPath": { "type": "string" }, "kind": { "const": "symlink-mirror" }, "independentAuthority": { "const": false } } },
    "artifactClass": { "type": "object", "additionalProperties": false, "required": ["pattern", "classification", "codingAuthority", "rule"], "properties": { "pattern": { "type": "string" }, "classification": { "type": "string" }, "codingAuthority": { "type": "boolean" }, "rule": { "type": "string" } } },
    "taskRoute": { "type": "object", "additionalProperties": false, "required": ["id", "taskPattern", "startPaths"], "properties": { "id": { "type": "string" }, "taskPattern": { "type": "string" }, "startPaths": { "type": "array", "minItems": 1, "items": { "type": "string" } } } },
    "changeRoute": { "type": "object", "additionalProperties": false, "required": ["id", "sourcePaths", "callerPaths", "configurationPaths", "testPaths", "documentationPaths", "checkRouteIds"], "properties": { "id": { "type": "string" }, "sourcePaths": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "callerPaths": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "configurationPaths": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "testPaths": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "documentationPaths": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "checkRouteIds": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "pairedChangeIds": { "type": "array", "items": { "type": "string" } }, "knownGaps": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "negativeGuarantees": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } } },
    "checkRoute": { "type": "object", "additionalProperties": false, "required": ["id", "changeTypes", "focusedRule", "broaderCommandIds"], "properties": { "id": { "type": "string" }, "changeTypes": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "focusedRule": { "type": "string" }, "broaderCommandIds": { "type": "array", "minItems": 1, "items": { "type": "string" } } } },
    "pairedChange": { "type": "object", "additionalProperties": false, "required": ["id", "triggerPatterns", "requiredSurfaces", "forbiddenSurfaces"], "properties": { "id": { "type": "string" }, "triggerPatterns": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "requiredSurfaces": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "forbiddenSurfaces": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "existingOwnerDisposition": { "type": "string", "minLength": 1 }, "proposedUpdaterRequirements": { "type": "string", "minLength": 1 } } },
    "restrictedExclusion": { "type": "object", "additionalProperties": false, "required": ["pattern", "reason", "allowedAction"], "properties": { "pattern": { "type": "string" }, "reason": { "type": "string" }, "allowedAction": { "type": "string" } } },
    "ownerRole": { "type": "object", "additionalProperties": false, "required": ["id", "responsibility", "enforcement"], "properties": { "id": { "type": "string" }, "responsibility": { "type": "string" }, "enforcement": { "type": "string" } } },
    "route": { "type": "object", "additionalProperties": false, "required": ["id", "label", "path"], "properties": { "id": { "type": "string" }, "label": { "type": "string" }, "path": { "type": "string" }, "priority": { "type": "string" }, "status": { "type": "string" } } },
    "platformClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "journeyId", "configuredBundleTargets", "claimedPlatforms", "diagnosticOnlyEnvironments", "requiredEvidence"],
      "properties": {
        "id": { "type": "string" },
        "journeyId": { "type": "string" },
        "configuredBundleTargets": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "claimedPlatforms": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "diagnosticOnlyEnvironments": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "requiredEvidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/platformEvidenceRequirement" } }
      }
    },
    "platformEvidenceRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "environment", "status"],
      "properties": {
        "platform": { "type": "string" },
        "environment": { "const": "native" },
        "status": { "const": "DEFERRED — REQUIRED BEFORE MILESTONE 7" }
      }
    },
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topicId", "path", "title", "purpose", "audiences", "status", "applicability", "ownerRole", "expectedOutcome", "prerequisites"],
      "properties": {
        "topicId": { "type": "string" }, "path": { "type": "string" }, "title": { "type": "string" }, "purpose": { "type": "string" },
        "audiences": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "status": { "enum": ["current", "legacy", "historical", "experimental", "internal", "deprecated", "removed", "unsupported", "unresolved"] },
        "applicability": { "$ref": "#/$defs/applicability" }, "ownerRole": { "type": "string" }, "expectedOutcome": { "type": "string" },
        "prerequisites": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "projection": { "type": "boolean" },
        "keywords": { "type": "array", "minItems": 2, "items": { "type": "string" } }, "parentPath": { "type": "string" }, "adjacentTopics": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "applicability": { "type": "object", "additionalProperties": false, "properties": { "branches": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "milestone": { "type": "integer", "minimum": 0 }, "scope": { "type": "string" }, "tags": { "type": "string" }, "openItem": { "type": "string" }, "openItems": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "platformClaim": { "type": "string" }, "maturity": { "type": "string" } } },
    "openItem": { "type": "object", "additionalProperties": false, "required": ["id", "state", "summary"], "properties": { "id": { "type": "string" }, "state": { "type": "string" }, "summary": { "type": "string" } } },
    "document": { "type": "object", "additionalProperties": false, "required": ["path", "classification", "status", "ownerRole"], "properties": { "path": { "type": "string" }, "classification": { "type": "string" }, "status": { "enum": ["current", "legacy", "historical", "experimental", "internal", "deprecated", "removed", "unsupported", "unresolved"] }, "ownerRole": { "type": "string" } } },
    "sourceMapping": { "type": "object", "additionalProperties": false, "required": ["source", "documentation", "impact"], "properties": { "source": { "type": "string" }, "documentation": { "type": "string" }, "impact": { "type": "string" } } },
    "alias": { "type": "object", "additionalProperties": false, "required": ["path", "canonicalPath", "kind", "status"], "properties": { "path": { "type": "string" }, "canonicalPath": { "type": "string" }, "kind": { "type": "string" }, "status": { "enum": ["current", "legacy", "historical", "experimental", "internal", "deprecated", "removed", "unsupported", "unresolved"] } } },
    "versionDomain": { "type": "object", "additionalProperties": false, "required": ["id", "sources", "status", "branchTagContract", "compatibilityContract"], "properties": { "id": { "type": "string" }, "sources": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "status": { "const": "current-distinct-domain" }, "branchTagContract": { "type": "string", "minLength": 1 }, "compatibilityContract": { "type": "string", "minLength": 1 } } },
    "migrationPolicy": { "type": "object", "additionalProperties": false, "required": ["id", "classifications", "disposition", "rule"], "properties": { "id": { "type": "string" }, "classifications": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "disposition": { "enum": ["retain", "relocate", "reclassify", "retire"] }, "rule": { "type": "string", "minLength": 1 } } },
    "deprecation": { "type": "object", "additionalProperties": false, "required": ["subject", "status", "replacement", "migrationGuidance", "compatibility", "removalState"], "properties": { "subject": { "type": "string" }, "status": { "type": "string" }, "replacement": { "type": "string" }, "migrationGuidance": { "type": "string" }, "compatibility": { "type": "string" }, "removalState": { "type": "string" } } },
    "topicBinding": { "type": "object", "additionalProperties": false, "required": ["topicId", "sources", "tests", "commands"], "properties": { "topicId": { "type": "string" }, "sources": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "tests": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "commands": { "type": "array", "minItems": 1, "items": { "type": "string" } } } },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command", "workingDirectory", "prerequisites", "platforms", "modes", "credentialNeed", "sideEffects", "expectedResult", "failureClassification", "cleanup", "riskTier", "recovery"],
      "properties": { "id": { "type": "string" }, "command": { "type": "string" }, "workingDirectory": { "type": "string" }, "prerequisites": { "type": "array", "items": { "type": "string" } }, "platforms": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "modes": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "credentialNeed": { "type": "string" }, "sideEffects": { "type": "string" }, "expectedResult": { "type": "string" }, "failureClassification": { "type": "string" }, "cleanup": { "type": "string" }, "recovery": { "type": "string" }, "riskTier": { "enum": ["A", "B", "C"] }, "target": { "type": "string", "minLength": 1 }, "authority": { "type": "string", "minLength": 1 } },
      "allOf": [{ "if": { "properties": { "riskTier": { "enum": ["B", "C"] } }, "required": ["riskTier"] }, "then": { "required": ["target", "authority"] } }]
    }
  }
}
