{
  "name": "@braindrive/personal-ai-ecosystem-prototypes",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "demo": "tsx scripts/demo.ts",
    "verify": "npm run build && npm test",
    "format": "prettier --write src test scripts/*.ts *.json *.md evidence/*.md evidence/*.json",
    "format:check": "prettier --check src test scripts/*.ts *.json *.md evidence/*.md evidence/*.json"
  },
  "dependencies": {
    "didwebvh-ts": "2.8.0",
    "nostr-tools": "2.25.2",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/ws": "8.18.2",
    "prettier": "3.9.9",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
