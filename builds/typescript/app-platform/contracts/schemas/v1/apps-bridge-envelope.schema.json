{
  "$id": "https://schemas.braindrive.ai/resume-builder/v1/apps-bridge-envelope.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "bridge_envelope_version": {
      "type": "number",
      "const": 1
    },
    "message_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "installation_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "view_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "operation_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "bridge_generation": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "direction": {
      "type": "string",
      "enum": [
        "app_to_host",
        "host_to_app"
      ]
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source_window_match": {
          "type": "boolean",
          "const": true
        },
        "opaque_origin": {
          "type": "string",
          "const": "null"
        },
        "same_server_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        }
      },
      "required": [
        "source_window_match",
        "opaque_origin",
        "same_server_id"
      ],
      "additionalProperties": false
    },
    "sent_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "message": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "jsonrpc": {
              "type": "string",
              "const": "2.0"
            },
            "id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              ]
            },
            "method": {
              "type": "string",
              "enum": [
                "ui/initialize",
                "ui/notifications/initialized",
                "ui/notifications/sandbox-proxy-ready",
                "ui/notifications/sandbox-resource-ready",
                "ui/notifications/size-changed",
                "ui/notifications/tool-input",
                "ui/notifications/tool-input-partial",
                "ui/notifications/tool-result",
                "ui/notifications/tool-cancelled",
                "ui/notifications/host-context-changed",
                "ui/notifications/request-teardown",
                "ui/resource-teardown",
                "ui/request-display-mode",
                "ui/open-link",
                "ui/download-file",
                "ui/message",
                "ui/update-model-context",
                "tools/list",
                "tools/call",
                "resources/list",
                "resources/templates/list",
                "resources/read"
              ]
            },
            "params": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "jsonrpc",
            "id",
            "method"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "jsonrpc": {
              "type": "string",
              "const": "2.0"
            },
            "method": {
              "type": "string",
              "enum": [
                "ui/initialize",
                "ui/notifications/initialized",
                "ui/notifications/sandbox-proxy-ready",
                "ui/notifications/sandbox-resource-ready",
                "ui/notifications/size-changed",
                "ui/notifications/tool-input",
                "ui/notifications/tool-input-partial",
                "ui/notifications/tool-result",
                "ui/notifications/tool-cancelled",
                "ui/notifications/host-context-changed",
                "ui/notifications/request-teardown",
                "ui/resource-teardown",
                "ui/request-display-mode",
                "ui/open-link",
                "ui/download-file",
                "ui/message",
                "ui/update-model-context",
                "tools/list",
                "tools/call",
                "resources/list",
                "resources/templates/list",
                "resources/read"
              ]
            },
            "params": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "jsonrpc",
            "method"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "jsonrpc": {
              "type": "string",
              "const": "2.0"
            },
            "id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              ]
            },
            "result": {}
          },
          "required": [
            "jsonrpc",
            "id",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "jsonrpc": {
              "type": "string",
              "const": "2.0"
            },
            "id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              ]
            },
            "error": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "message": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "data": {}
              },
              "required": [
                "code",
                "message"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "jsonrpc",
            "id",
            "error"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "bridge_envelope_version",
    "message_id",
    "installation_id",
    "view_id",
    "operation_id",
    "bridge_generation",
    "direction",
    "provenance",
    "sent_at",
    "message"
  ],
  "additionalProperties": false
}
