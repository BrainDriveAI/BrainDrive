{
  "$id": "https://schemas.braindrive.ai/resume-builder/v1/package-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "manifest_version": {
      "type": "number",
      "const": 1
    },
    "app_id": {
      "type": "string",
      "const": "ai.braindrive.resume-builder"
    },
    "publisher_id": {
      "type": "string",
      "const": "ai.braindrive"
    },
    "display_name": {
      "type": "string",
      "const": "Resume Builder"
    },
    "package_version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "archive": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "const": "zip"
        },
        "profile": {
          "type": "string",
          "const": "braindrive-zip-v1"
        },
        "compression": {
          "type": "string",
          "const": "store"
        },
        "layout_version": {
          "type": "number",
          "const": 1
        },
        "manifest_path": {
          "type": "string",
          "const": "manifest.json"
        },
        "undeclared_entries": {
          "type": "string",
          "const": "reject"
        },
        "links_and_device_nodes": {
          "type": "string",
          "const": "reject"
        },
        "max_file_count": {
          "type": "number",
          "const": 256
        },
        "max_compressed_bytes": {
          "type": "number",
          "const": 67108864
        },
        "max_uncompressed_bytes": {
          "type": "number",
          "const": 268435456
        }
      },
      "required": [
        "format",
        "profile",
        "compression",
        "layout_version",
        "manifest_path",
        "undeclared_entries",
        "links_and_device_nodes",
        "max_file_count",
        "max_compressed_bytes",
        "max_uncompressed_bytes"
      ],
      "additionalProperties": false
    },
    "files": {
      "minItems": 3,
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "kind": {
            "type": "string",
            "const": "file"
          },
          "mode": {
            "type": "string",
            "enum": [
              "read_only",
              "executable"
            ]
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 268435456
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "kind",
          "mode",
          "size_bytes",
          "digest"
        ],
        "additionalProperties": false
      }
    },
    "platform_artifacts": {
      "minItems": 2,
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string",
            "enum": [
              "docker_linux_x64",
              "desktop_windows_x64"
            ]
          },
          "os": {
            "type": "string",
            "enum": [
              "linux",
              "windows"
            ]
          },
          "architecture": {
            "type": "string",
            "const": "x64"
          },
          "runtime_kind": {
            "type": "string",
            "const": "packaged_node"
          },
          "entrypoint": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "target",
          "os",
          "architecture",
          "runtime_kind",
          "entrypoint"
        ],
        "additionalProperties": false
      }
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "app_contract": {
          "type": "number",
          "const": 1
        },
        "host_min_version": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$"
        },
        "mcp_protocol": {
          "type": "string",
          "const": "2026-07-28"
        },
        "legacy_mcp_adapter": {
          "type": "string",
          "const": "2025-11-25"
        },
        "mcp_apps": {
          "type": "object",
          "properties": {
            "extension_id": {
              "type": "string",
              "const": "io.modelcontextprotocol/ui"
            },
            "version": {
              "type": "string",
              "const": "2026-01-26"
            }
          },
          "required": [
            "extension_id",
            "version"
          ],
          "additionalProperties": false
        },
        "data_schema": {
          "type": "object",
          "properties": {
            "read_min": {
              "type": "number",
              "const": 1
            },
            "read_max": {
              "type": "number",
              "const": 1
            },
            "write_version": {
              "type": "number",
              "const": 1
            }
          },
          "required": [
            "read_min",
            "read_max",
            "write_version"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "app_contract",
        "host_min_version",
        "mcp_protocol",
        "legacy_mcp_adapter",
        "mcp_apps",
        "data_schema"
      ],
      "additionalProperties": false
    },
    "requested_capabilities": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "career.context.read",
          "career.facts.read",
          "career.facts.propose",
          "career.facts.confirm",
          "resume.definitions.read",
          "resume.definitions.write",
          "resume.jobs.read",
          "resume.jobs.write",
          "resume.artifacts.register",
          "resume.export.request",
          "resume.operations.read",
          "app.inference.request"
        ]
      }
    },
    "provenance_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "sbom_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "retention_policy": {
      "type": "string",
      "const": "retain_owner_data_remove_runtime_authority"
    }
  },
  "required": [
    "manifest_version",
    "app_id",
    "publisher_id",
    "display_name",
    "package_version",
    "archive",
    "files",
    "platform_artifacts",
    "compatibility",
    "requested_capabilities",
    "provenance_path",
    "sbom_path",
    "retention_policy"
  ],
  "additionalProperties": false
}
