{
  "$id": "https://schemas.braindrive.ai/resume-builder/v1/resume-strategy-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 3
    },
    "record_type": {
      "type": "string",
      "const": "resume_strategy"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "record_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "revision_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "created_by": {
          "type": "object",
          "properties": {
            "owner_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "actor_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "app_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "publisher_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "package_digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "installation_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": [
            "owner_id",
            "actor_id",
            "app_id",
            "publisher_id",
            "package_digest",
            "installation_id"
          ],
          "additionalProperties": false
        },
        "prior_revision_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "extensions": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "record_id",
        "revision_id",
        "revision",
        "created_at",
        "created_by",
        "prior_revision_id"
      ],
      "additionalProperties": false
    },
    "owner_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "lifecycle_state": {
      "type": "string",
      "enum": [
        "active",
        "superseded",
        "retired"
      ]
    },
    "sensitivity": {
      "type": "string",
      "enum": [
        "standard",
        "sensitive",
        "highly_sensitive"
      ]
    },
    "retention_class": {
      "type": "string",
      "enum": [
        "durable_owner_data",
        "durable_provenance_while_referenced",
        "durable_operation_lookup",
        "rollback_recovery_window",
        "disposable_preview_cache",
        "transient_abandoned_operation",
        "external_owner_file",
        "runtime_authority"
      ]
    },
    "extensions": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "strategy_version": {
      "type": "number",
      "const": 1
    },
    "fact_snapshot_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "fact_revision_ids": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      }
    },
    "coverage_revision_ids": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      }
    },
    "target_revision_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "history_shape": {
      "type": "string",
      "enum": [
        "chronological_standard",
        "early_career",
        "senior_selective",
        "career_change",
        "return_to_work",
        "concurrent_roles"
      ]
    },
    "role_emphasis": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "job_fact_revision_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "priority": {
            "type": "string",
            "enum": [
              "primary",
              "supporting",
              "compressed"
            ]
          },
          "reason_code": {
            "type": "string",
            "enum": [
              "recent",
              "relevant",
              "evidence_rich",
              "continuity",
              "older_context"
            ]
          },
          "bullet_density": {
            "type": "string",
            "enum": [
              "none",
              "compact",
              "standard",
              "expanded"
            ]
          }
        },
        "required": [
          "job_fact_revision_id",
          "priority",
          "reason_code",
          "bullet_density"
        ],
        "additionalProperties": false
      }
    },
    "history_reason_code": {
      "type": "string",
      "enum": [
        "standard_chronology",
        "thin_history",
        "senior_compression",
        "career_transition",
        "employment_gap",
        "overlap_or_promotion"
      ]
    },
    "section_order": {
      "minItems": 1,
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "evidence_priorities": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fact_revision_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "priority": {
            "type": "string",
            "enum": [
              "must_use",
              "preferred",
              "context"
            ]
          }
        },
        "required": [
          "fact_revision_id",
          "priority"
        ],
        "additionalProperties": false
      }
    },
    "summary_decision": {
      "type": "string",
      "enum": [
        "include",
        "omit"
      ]
    },
    "summary_reason_code": {
      "type": "string",
      "enum": [
        "supported_positioning",
        "insufficient_distinct_value",
        "redundant_with_experience"
      ]
    },
    "skills_context": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "skill_fact_revision_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "placement": {
            "type": "string",
            "enum": [
              "role",
              "project",
              "skills_section"
            ]
          },
          "context_fact_revision_ids": {
            "maxItems": 16,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          }
        },
        "required": [
          "skill_fact_revision_id",
          "placement",
          "context_fact_revision_ids"
        ],
        "additionalProperties": false
      }
    },
    "omissions": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fact_revision_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "reason_code": {
            "type": "string",
            "enum": [
              "redundant",
              "low_relevance",
              "space",
              "older_context",
              "owner_direction",
              "structural_mismatch",
              "conflict"
            ]
          }
        },
        "required": [
          "fact_revision_id",
          "reason_code"
        ],
        "additionalProperties": false
      }
    },
    "unresolved_gap_ids": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      }
    },
    "owner_rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "prompt_policy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "prompt_policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "quality_standard_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "quality_standard_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "quality_standard_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "provider_profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "model_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "input_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "output_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "metadata",
    "owner_id",
    "updated_at",
    "lifecycle_state",
    "sensitivity",
    "retention_class",
    "strategy_version",
    "fact_snapshot_digest",
    "fact_revision_ids",
    "coverage_revision_ids",
    "target_revision_id",
    "history_shape",
    "role_emphasis",
    "history_reason_code",
    "section_order",
    "evidence_priorities",
    "summary_decision",
    "summary_reason_code",
    "skills_context",
    "omissions",
    "unresolved_gap_ids",
    "owner_rationale",
    "prompt_policy_id",
    "prompt_policy_version",
    "quality_standard_id",
    "quality_standard_version",
    "quality_standard_digest",
    "provider_profile_id",
    "model_id",
    "input_digest",
    "output_digest"
  ],
  "additionalProperties": false
}
