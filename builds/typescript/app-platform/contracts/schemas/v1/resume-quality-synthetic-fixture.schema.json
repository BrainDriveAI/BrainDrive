{
  "$id": "https://schemas.braindrive.ai/resume-builder/v1/resume-quality-synthetic-fixture.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "fixture_schema_version": {
      "type": "number",
      "const": 1
    },
    "fixture_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "synthetic": {
      "type": "boolean",
      "const": true
    },
    "persona": {
      "type": "string",
      "enum": [
        "early_career",
        "thin_history",
        "career_changer",
        "recent_loss",
        "senior",
        "metric_poor",
        "renderer_failure"
      ]
    },
    "canary_literals": {
      "minItems": 1,
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 12,
        "maxLength": 128
      }
    },
    "approved_definition": {
      "type": "object",
      "properties": {
        "sections": {
          "minItems": 1,
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "logical_lines": {
          "minItems": 1,
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        }
      },
      "required": [
        "sections",
        "logical_lines"
      ],
      "additionalProperties": false
    },
    "expected_recovery": {
      "type": "object",
      "properties": {
        "section_count": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 16
        },
        "line_count": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 500
        }
      },
      "required": [
        "section_count",
        "line_count"
      ],
      "additionalProperties": false
    },
    "m3_job_evidence": {
      "type": "object",
      "properties": {
        "confirmed_evidence_revision_ids": {
          "minItems": 1,
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "roles": {
          "minItems": 1,
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "job_revision_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "role_class": {
                "type": "string",
                "enum": [
                  "substantive",
                  "sparse",
                  "older"
                ]
              },
              "answered_evidence_revision_ids": {
                "maxItems": 12,
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                }
              },
              "output_bullets": {
                "maxItems": 6,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    "supporting_revision_ids": {
                      "minItems": 1,
                      "maxItems": 12,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "format": "uuid",
                        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                      }
                    }
                  },
                  "required": [
                    "text",
                    "supporting_revision_ids"
                  ],
                  "additionalProperties": false
                }
              },
              "contextual_skill_statements": {
                "maxItems": 6,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    "supporting_revision_ids": {
                      "minItems": 1,
                      "maxItems": 12,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "format": "uuid",
                        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                      }
                    }
                  },
                  "required": [
                    "text",
                    "supporting_revision_ids"
                  ],
                  "additionalProperties": false
                }
              },
              "summary_statements": {
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    "supporting_revision_ids": {
                      "minItems": 1,
                      "maxItems": 12,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "format": "uuid",
                        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                      }
                    }
                  },
                  "required": [
                    "text",
                    "supporting_revision_ids"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "job_revision_id",
              "role_class",
              "answered_evidence_revision_ids",
              "output_bullets",
              "contextual_skill_statements",
              "summary_statements"
            ],
            "additionalProperties": false
          }
        },
        "chronological_job_revision_ids": {
          "minItems": 1,
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "output_job_revision_ids": {
          "minItems": 1,
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "optional_question_prompts": {
          "minItems": 1,
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      },
      "required": [
        "confirmed_evidence_revision_ids",
        "roles",
        "chronological_job_revision_ids",
        "output_job_revision_ids",
        "optional_question_prompts"
      ],
      "additionalProperties": false
    },
    "m4_successor": {
      "type": "object",
      "properties": {
        "source_logical_lines": {
          "minItems": 1,
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "successor_logical_lines": {
          "minItems": 1,
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "expected_preserved_lines": {
          "minItems": 1,
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "corrected_lines": {
          "minItems": 1,
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "before": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "after": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            },
            "required": [
              "before",
              "after"
            ],
            "additionalProperties": false
          }
        },
        "added_lines": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        }
      },
      "required": [
        "source_logical_lines",
        "successor_logical_lines",
        "expected_preserved_lines",
        "corrected_lines",
        "added_lines"
      ],
      "additionalProperties": false
    },
    "m6_revision_successor": {
      "type": "object",
      "properties": {
        "classification": {
          "type": "string",
          "enum": [
            "presentation",
            "factual",
            "mixed"
          ]
        },
        "source_logical_lines": {
          "minItems": 1,
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "successor_logical_lines": {
          "minItems": 1,
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "expected_preserved_lines": {
          "minItems": 1,
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "rewritten_lines": {
          "minItems": 1,
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "before": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "after": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            },
            "required": [
              "before",
              "after"
            ],
            "additionalProperties": false
          }
        },
        "source_support_revision_ids": {
          "minItems": 1,
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "successor_support_revision_ids": {
          "minItems": 1,
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        }
      },
      "required": [
        "classification",
        "source_logical_lines",
        "successor_logical_lines",
        "expected_preserved_lines",
        "rewritten_lines",
        "source_support_revision_ids",
        "successor_support_revision_ids"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "fixture_schema_version",
    "fixture_id",
    "synthetic",
    "persona",
    "canary_literals",
    "approved_definition",
    "expected_recovery"
  ],
  "additionalProperties": false
}
