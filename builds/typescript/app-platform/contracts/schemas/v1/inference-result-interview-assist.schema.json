{
  "$id": "https://schemas.braindrive.ai/resume-builder/v1/inference-result-interview-assist.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "questions": {
      "minItems": 1,
      "maxItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "job_fact_revision_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "dimension": {
            "type": "string",
            "enum": [
              "responsibilities",
              "tools",
              "accomplishments",
              "outcomes",
              "scope",
              "progression"
            ]
          },
          "selection_method": {
            "type": "string",
            "const": "broker_ranked"
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "question_id",
          "job_fact_revision_id",
          "dimension",
          "selection_method",
          "prompt",
          "rationale"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "questions"
  ],
  "additionalProperties": false
}
