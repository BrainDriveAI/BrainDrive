{
  "$id": "https://schemas.braindrive.ai/resume-builder/v1/inference-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "inference_schema_version": {
      "type": "number",
      "const": 1
    },
    "request_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "owner_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "actor_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "app_id": {
      "type": "string",
      "const": "ai.braindrive.resume-builder"
    },
    "installation_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "operation_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "grant_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "purpose": {
      "type": "string",
      "enum": [
        "interview_assist",
        "general_resume_draft",
        "job_description_analyze",
        "requirement_evidence_match",
        "tailoring_plan",
        "targeted_resume_draft",
        "resume_revision_classify",
        "resume_revision_draft",
        "resume_guidance",
        "resume_strategy",
        "resume_craft_evaluate",
        "resume_craft_repair"
      ]
    },
    "input_snapshot": {
      "type": "object",
      "properties": {
        "fact_snapshot_revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "fact_snapshot_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "record_revision_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        }
      },
      "required": [
        "fact_snapshot_revision",
        "fact_snapshot_digest",
        "record_revision_ids"
      ],
      "additionalProperties": false
    },
    "data_blocks": {
      "minItems": 1,
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "confirmed_fact_snapshot",
              "presentation_preferences",
              "general_resume_definition",
              "job_description",
              "job_analysis",
              "evidence_matrix",
              "owner_edit",
              "revision_instruction",
              "definition_comparison",
              "deterministic_findings",
              "job_evidence_summary",
              "coverage_summary",
              "resume_strategy",
              "target_fit_analysis",
              "craft_quality_report",
              "craft_repair_scope",
              "craft_gate_policy",
              "craft_anchor_evidence",
              "evidence_annotations",
              "quality_policy",
              "target_fit_policy"
            ]
          },
          "content_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "schema_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "schema_version": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "data": {}
        },
        "required": [
          "category",
          "content_digest",
          "schema_id",
          "schema_version",
          "data"
        ],
        "additionalProperties": false
      }
    },
    "prompt_policy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "prompt_policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "output_schema_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "output_schema_version": {
      "type": "number",
      "const": 1
    },
    "capability_requirements": {
      "type": "object",
      "properties": {
        "text_generation": {
          "type": "boolean",
          "const": true
        },
        "complete_structured_json": {
          "type": "boolean",
          "const": true
        },
        "minimum_context_tokens": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "model_tools": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "text_generation",
        "complete_structured_json",
        "minimum_context_tokens",
        "model_tools"
      ],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "input_bytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "input_tokens": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "output_tokens": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "duration_ms": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "concurrency": {
          "type": "number",
          "const": 1
        }
      },
      "required": [
        "input_bytes",
        "input_tokens",
        "output_tokens",
        "duration_ms",
        "attempts",
        "concurrency"
      ],
      "additionalProperties": false
    },
    "requested_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "deadline_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "inference_schema_version",
    "request_id",
    "owner_id",
    "actor_id",
    "app_id",
    "installation_id",
    "operation_id",
    "grant_id",
    "purpose",
    "input_snapshot",
    "data_blocks",
    "prompt_policy_id",
    "prompt_policy_version",
    "output_schema_id",
    "output_schema_version",
    "capability_requirements",
    "limits",
    "requested_at",
    "deadline_at"
  ],
  "additionalProperties": false
}
