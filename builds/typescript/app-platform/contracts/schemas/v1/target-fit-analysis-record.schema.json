{
  "$id": "https://schemas.braindrive.ai/resume-builder/v1/target-fit-analysis-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "anyOf": [
        {
          "type": "number",
          "const": 3
        },
        {
          "type": "number",
          "const": 4
        }
      ]
    },
    "record_type": {
      "type": "string",
      "const": "target_fit_analysis"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "record_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "revision_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "created_by": {
          "type": "object",
          "properties": {
            "owner_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "actor_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "app_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "publisher_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "package_digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "installation_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": [
            "owner_id",
            "actor_id",
            "app_id",
            "publisher_id",
            "package_digest",
            "installation_id"
          ],
          "additionalProperties": false
        },
        "prior_revision_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "extensions": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "record_id",
        "revision_id",
        "revision",
        "created_at",
        "created_by",
        "prior_revision_id"
      ],
      "additionalProperties": false
    },
    "owner_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "lifecycle_state": {
      "type": "string",
      "enum": [
        "active",
        "superseded",
        "retired"
      ]
    },
    "sensitivity": {
      "type": "string",
      "enum": [
        "standard",
        "sensitive",
        "highly_sensitive"
      ]
    },
    "retention_class": {
      "type": "string",
      "enum": [
        "durable_owner_data",
        "durable_provenance_while_referenced",
        "durable_operation_lookup",
        "rollback_recovery_window",
        "disposable_preview_cache",
        "transient_abandoned_operation",
        "external_owner_file",
        "runtime_authority"
      ]
    },
    "extensions": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "analysis_version": {
      "type": "number",
      "const": 1
    },
    "parent_general_definition_revision_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "job_revision_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "target_content_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "strategy_revision_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "strategy_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "fact_snapshot_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "fact_revision_ids": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      }
    },
    "evidence_matrix_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "fit_class": {
      "type": "string",
      "enum": [
        "meaningfully_supported",
        "partially_supported_transferable",
        "lacking_supported_core_fit"
      ]
    },
    "support_counts": {
      "type": "object",
      "properties": {
        "core": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "transferable": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "partial": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unsupported": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "core",
        "transferable",
        "partial",
        "unsupported"
      ],
      "additionalProperties": false
    },
    "material_changes": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "change_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "requirement_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "statement_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              {
                "type": "null"
              }
            ]
          },
          "action": {
            "type": "string",
            "enum": [
              "selection",
              "ordering",
              "emphasis",
              "faithful_wording",
              "shorten"
            ]
          },
          "supporting_confirmed_fact_revision_ids": {
            "minItems": 1,
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          }
        },
        "required": [
          "change_id",
          "requirement_id",
          "statement_id",
          "action",
          "supporting_confirmed_fact_revision_ids"
        ],
        "additionalProperties": false
      }
    },
    "threshold_policy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "threshold_policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "prompt_policy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "prompt_policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "provider_profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "model_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "input_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "output_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "targeted_variant",
        "no_meaningful_change"
      ]
    },
    "analysis_state": {
      "type": "string",
      "enum": [
        "ready_for_targeted_draft",
        "completed"
      ]
    },
    "no_change_reason": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "ambiguous_evidence",
            "insufficient_supported_fit",
            "no_material_resume_change"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "owner_next_actions": {
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "use_general_resume",
          "answer_optional_evidence_questions",
          "try_different_target"
        ]
      }
    },
    "targeted_definition_revision_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "analysis_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "metadata",
    "owner_id",
    "updated_at",
    "lifecycle_state",
    "sensitivity",
    "retention_class",
    "analysis_version",
    "parent_general_definition_revision_id",
    "job_revision_id",
    "target_content_digest",
    "strategy_revision_id",
    "strategy_digest",
    "fact_snapshot_digest",
    "fact_revision_ids",
    "evidence_matrix_digest",
    "fit_class",
    "support_counts",
    "material_changes",
    "threshold_policy_id",
    "threshold_policy_version",
    "prompt_policy_id",
    "prompt_policy_version",
    "provider_profile_id",
    "model_id",
    "input_digest",
    "output_digest",
    "outcome",
    "analysis_state",
    "no_change_reason",
    "owner_next_actions",
    "targeted_definition_revision_id",
    "analysis_digest"
  ],
  "additionalProperties": false
}
