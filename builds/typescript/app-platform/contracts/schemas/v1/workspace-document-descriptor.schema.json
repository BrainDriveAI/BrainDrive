{
  "$id": "https://schemas.braindrive.ai/app-platform/v1/workspace-document-descriptor.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "document_version": {
      "type": "number",
      "const": 1
    },
    "document_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "role": {
      "type": "string",
      "enum": [
        "conversation",
        "source_document",
        "derived_document",
        "advanced_resource",
        "recovery",
        "recovery_document",
        "action_result_document"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "editable": {
      "type": "boolean"
    },
    "default_visibility": {
      "type": "string",
      "enum": [
        "primary",
        "secondary",
        "advanced"
      ]
    },
    "model_access": {
      "type": "string",
      "enum": [
        "none",
        "read_reference",
        "read_write_draft",
        "action_result"
      ]
    },
    "resource_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "data_binding_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "initial_content": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "initial_content_version": {
              "type": "number",
              "const": 1
            },
            "source": {
              "type": "string",
              "const": "package_file"
            },
            "package_path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "media_type": {
              "type": "string",
              "enum": [
                "text/markdown",
                "text/plain",
                "application/json"
              ]
            },
            "content_digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "seed_policy": {
              "type": "string",
              "enum": [
                "when_missing"
              ]
            }
          },
          "required": [
            "initial_content_version",
            "source",
            "package_path",
            "media_type",
            "content_digest",
            "seed_policy"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "presentation": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "presentation_version": {
              "type": "number",
              "const": 1
            },
            "renderer": {
              "type": "string",
              "enum": [
                "plain_text",
                "markdown_document",
                "paper_document",
                "json_editor"
              ]
            },
            "chrome": {
              "type": "string",
              "enum": [
                "standard",
                "document"
              ]
            },
            "title": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                {
                  "type": "null"
                }
              ]
            },
            "subtitle": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                {
                  "type": "null"
                }
              ]
            },
            "header_actions": {
              "maxItems": 6,
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "back_to_chat"
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40
                      }
                    },
                    "required": [
                      "type",
                      "label"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "edit_document"
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40
                      }
                    },
                    "required": [
                      "type",
                      "label"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "app_action"
                      },
                      "action_id": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 128,
                        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40
                      },
                      "delivery": {
                        "type": "string",
                        "const": "chat_prompt"
                      },
                      "prompt": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 512
                      }
                    },
                    "required": [
                      "type",
                      "action_id",
                      "label",
                      "delivery",
                      "prompt"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            }
          },
          "required": [
            "presentation_version",
            "renderer",
            "chrome",
            "title",
            "subtitle",
            "header_actions"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "document_version",
    "document_id",
    "role",
    "title",
    "description",
    "editable",
    "default_visibility",
    "model_access",
    "resource_id",
    "data_binding_id"
  ],
  "additionalProperties": false
}
