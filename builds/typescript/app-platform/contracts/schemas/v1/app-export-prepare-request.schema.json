{
  "$id": "https://schemas.braindrive.ai/app-platform/v1/app-export-prepare-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "request_version": {
      "type": "number",
      "const": 1
    },
    "authority": {
      "type": "object",
      "properties": {
        "authority_version": {
          "type": "number",
          "const": 1
        },
        "owner_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "actor_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "app_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
        },
        "publisher_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 96,
          "pattern": "^[a-z0-9]+(?:\\.[a-z0-9]+)+$"
        },
        "installation_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "package_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "lifecycle_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "grant_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "grant_revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "revocation_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "authority_version",
        "owner_id",
        "actor_id",
        "app_id",
        "publisher_id",
        "installation_id",
        "package_digest",
        "lifecycle_generation",
        "grant_id",
        "grant_revision",
        "revocation_generation"
      ],
      "additionalProperties": false
    },
    "operation_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 256
    },
    "source": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "app_document",
            "app_operation",
            "runtime_output"
          ]
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[a-zA-Z0-9_.:@-]+$"
        }
      },
      "required": [
        "kind",
        "source_id"
      ],
      "additionalProperties": false
    },
    "content_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "content_size_bytes": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 2097152
    },
    "retention_class": {
      "default": "durable_owner_data",
      "type": "string",
      "enum": [
        "durable_owner_data",
        "durable_provenance_while_referenced",
        "durable_operation_lookup",
        "rollback_recovery_window",
        "disposable_preview_cache",
        "transient_abandoned_operation"
      ]
    },
    "media_type": {
      "type": "string",
      "enum": [
        "application/pdf",
        "text/plain"
      ]
    },
    "filename": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^/\\\\\\u0000-\\u001f\\u007f]+$"
    },
    "destination_intent": {
      "type": "string",
      "enum": [
        "new_download",
        "replace_existing"
      ]
    },
    "overwrite_confirmed": {
      "type": "boolean"
    },
    "owner_confirmed": {
      "type": "boolean"
    },
    "bytes_base64": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2796204,
      "pattern": "^[A-Za-z0-9+/]*={0,2}$"
    },
    "artifact_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "artifact_revision_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "is_cancelled": {
      "type": "boolean"
    }
  },
  "required": [
    "request_version",
    "authority",
    "operation_id",
    "idempotency_key",
    "source",
    "content_digest",
    "content_size_bytes",
    "media_type",
    "filename",
    "destination_intent",
    "overwrite_confirmed",
    "owner_confirmed",
    "bytes_base64"
  ],
  "additionalProperties": false
}
