{
  "$id": "https://schemas.braindrive.ai/resume-builder/v1/mcp-negotiated-peer.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "negotiation_version": {
      "type": "number",
      "const": 1
    },
    "connection_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "connection_generation": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "app_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "publisher_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "package_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "installation_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "runtime_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "client_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "client_version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "server_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "server_version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "profile": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "profile_version": {
              "type": "number",
              "const": 1
            },
            "era": {
              "type": "string",
              "const": "modern_stateless"
            },
            "protocol_version": {
              "type": "string",
              "const": "2026-07-28"
            },
            "negotiation": {
              "type": "string",
              "const": "version_negotiation_and_optional_server_discover"
            },
            "session_header": {
              "type": "boolean",
              "const": false
            },
            "required_methods": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "string",
                  "const": "tools/list"
                },
                {
                  "type": "string",
                  "const": "tools/call"
                },
                {
                  "type": "string",
                  "const": "resources/list"
                },
                {
                  "type": "string",
                  "const": "resources/templates/list"
                },
                {
                  "type": "string",
                  "const": "resources/read"
                }
              ]
            },
            "apps": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "const": "io.modelcontextprotocol/ui"
                },
                "version": {
                  "type": "string",
                  "const": "2026-01-26"
                }
              },
              "required": [
                "id",
                "version"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "profile_version",
            "era",
            "protocol_version",
            "negotiation",
            "session_header",
            "required_methods",
            "apps"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "profile_version": {
              "type": "number",
              "const": 1
            },
            "era": {
              "type": "string",
              "const": "bounded_legacy_stateful"
            },
            "protocol_version": {
              "type": "string",
              "const": "2025-11-25"
            },
            "negotiation": {
              "type": "string",
              "const": "initialize_initialized"
            },
            "session_header": {
              "type": "boolean",
              "const": true
            },
            "required_methods": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "string",
                  "const": "tools/list"
                },
                {
                  "type": "string",
                  "const": "tools/call"
                }
              ]
            },
            "apps": {
              "type": "null",
              "const": null
            }
          },
          "required": [
            "profile_version",
            "era",
            "protocol_version",
            "negotiation",
            "session_header",
            "required_methods",
            "apps"
          ],
          "additionalProperties": false
        }
      ]
    },
    "advertised_methods": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "unknown_critical_facilities": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "compatible": {
      "type": "boolean"
    },
    "negotiated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "negotiation_version",
    "connection_id",
    "connection_generation",
    "app_id",
    "publisher_id",
    "package_digest",
    "installation_id",
    "runtime_id",
    "client_name",
    "client_version",
    "server_name",
    "server_version",
    "profile",
    "advertised_methods",
    "unknown_critical_facilities",
    "compatible",
    "negotiated_at"
  ],
  "additionalProperties": false
}
