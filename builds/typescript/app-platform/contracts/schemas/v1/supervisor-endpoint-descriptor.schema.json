{
  "$id": "https://schemas.braindrive.ai/resume-builder/v1/supervisor-endpoint-descriptor.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "endpoint_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "transport": {
      "type": "string",
      "enum": [
        "container_internal",
        "loopback"
      ]
    },
    "address": {
      "type": "string",
      "pattern": "^http:\\/\\/(?:127\\.0\\.0\\.1|[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?):(?:[1-9]\\d{0,4})$"
    },
    "authentication": {
      "type": "string",
      "const": "per_installation_token"
    },
    "endpoint_token_generation": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "public_bind": {
      "type": "boolean",
      "const": false
    }
  },
  "required": [
    "endpoint_id",
    "transport",
    "address",
    "authentication",
    "endpoint_token_generation",
    "public_bind"
  ],
  "additionalProperties": false
}
