{
  "$id": "https://schemas.braindrive.ai/resume-builder/v1/lifecycle-operation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "lifecycle_operation_version": {
      "type": "number",
      "const": 1
    },
    "operation_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 256
    },
    "canonical_input_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "owner_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "actor_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "app_id": {
      "type": "string",
      "const": "ai.braindrive.resume-builder"
    },
    "installation_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "install",
        "reinstall",
        "disable",
        "enable",
        "update",
        "rollback",
        "uninstall",
        "recover",
        "quarantine",
        "reconcile"
      ]
    },
    "prior_record_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "prior_generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "prior_state": {
      "type": "string",
      "enum": [
        "not_installed",
        "staged",
        "active",
        "disabled",
        "updating",
        "rollback_pending",
        "uninstalling",
        "quarantined",
        "failed_recoverable"
      ]
    },
    "target_state": {
      "type": "string",
      "enum": [
        "not_installed",
        "staged",
        "active",
        "disabled",
        "updating",
        "rollback_pending",
        "uninstalling",
        "quarantined",
        "failed_recoverable"
      ]
    },
    "next_state": {
      "type": "string",
      "enum": [
        "not_installed",
        "staged",
        "active",
        "disabled",
        "updating",
        "rollback_pending",
        "uninstalling",
        "quarantined",
        "failed_recoverable"
      ]
    },
    "stage": {
      "type": "string",
      "enum": [
        "requested",
        "verifying_source",
        "verifying_package",
        "staging",
        "granting",
        "snapshotting",
        "migrating",
        "starting",
        "awaiting_readiness",
        "switching_active_pointer",
        "registering",
        "revoking_tokens",
        "stopping",
        "clearing_references",
        "removing_package_bytes",
        "removing_disposable_cache",
        "recording_tombstone",
        "rolling_back",
        "removing_runtime_authority",
        "reconciling",
        "completed"
      ]
    },
    "completed_stages": {
      "maxItems": 18,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "requested",
          "verifying_source",
          "verifying_package",
          "staging",
          "granting",
          "snapshotting",
          "migrating",
          "starting",
          "awaiting_readiness",
          "switching_active_pointer",
          "registering",
          "revoking_tokens",
          "stopping",
          "clearing_references",
          "removing_package_bytes",
          "removing_disposable_cache",
          "recording_tombstone",
          "rolling_back",
          "removing_runtime_authority",
          "reconciling",
          "completed"
        ]
      }
    },
    "compensations": {
      "maxItems": 18,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string",
            "enum": [
              "requested",
              "verifying_source",
              "verifying_package",
              "staging",
              "granting",
              "snapshotting",
              "migrating",
              "starting",
              "awaiting_readiness",
              "switching_active_pointer",
              "registering",
              "revoking_tokens",
              "stopping",
              "clearing_references",
              "removing_package_bytes",
              "removing_disposable_cache",
              "recording_tombstone",
              "rolling_back",
              "removing_runtime_authority",
              "reconciling",
              "completed"
            ]
          },
          "action": {
            "type": "string",
            "enum": [
              "remove_staging",
              "stop_candidate",
              "restore_pointer",
              "restore_snapshot",
              "revoke_tokens",
              "remove_registration"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "completed",
              "failed"
            ]
          }
        },
        "required": [
          "stage",
          "action",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "accepted",
        "running",
        "cancel_requested",
        "committed",
        "cancelled_before_commit",
        "failed"
      ]
    },
    "commit_outcome": {
      "type": "string",
      "enum": [
        "not_committed",
        "committed",
        "committed_response_recovered",
        "rolled_back_before_commit"
      ]
    },
    "recovery": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "none",
            "remove_staging_and_restore_prior",
            "stop_candidate_and_restore_prior",
            "restore_snapshot_and_last_known_good",
            "revoke_and_quarantine",
            "reconcile_committed_pointer",
            "complete_runtime_authority_removal"
          ]
        },
        "from_stage": {
          "type": "string",
          "enum": [
            "requested",
            "verifying_source",
            "verifying_package",
            "staging",
            "granting",
            "snapshotting",
            "migrating",
            "starting",
            "awaiting_readiness",
            "switching_active_pointer",
            "registering",
            "revoking_tokens",
            "stopping",
            "clearing_references",
            "removing_package_bytes",
            "removing_disposable_cache",
            "recording_tombstone",
            "rolling_back",
            "removing_runtime_authority",
            "reconciling",
            "completed"
          ]
        },
        "safe_state": {
          "type": "string",
          "enum": [
            "not_installed",
            "staged",
            "active",
            "disabled",
            "updating",
            "rollback_pending",
            "uninstalling",
            "quarantined",
            "failed_recoverable"
          ]
        },
        "snapshot_ref": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "action",
        "from_stage",
        "safe_state",
        "snapshot_ref"
      ],
      "additionalProperties": false
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "completed_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "result": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "result_version": {
              "type": "number",
              "const": 1
            },
            "outcome": {
              "type": "string",
              "enum": [
                "committed",
                "no_change",
                "rolled_back",
                "quarantined",
                "failed_recoverable"
              ]
            },
            "final_state": {
              "type": "string",
              "enum": [
                "not_installed",
                "staged",
                "active",
                "disabled",
                "updating",
                "rollback_pending",
                "uninstalling",
                "quarantined",
                "failed_recoverable"
              ]
            },
            "final_generation": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "active_package_digest": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "retained_last_known_good_digest": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "runtime_authority_removed": {
              "type": "boolean"
            },
            "owner_data_preserved": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "result_version",
            "outcome",
            "final_state",
            "final_generation",
            "active_package_digest",
            "retained_last_known_good_digest",
            "runtime_authority_removed",
            "owner_data_preserved"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "lifecycle_operation_version",
    "operation_id",
    "idempotency_key",
    "canonical_input_digest",
    "owner_id",
    "actor_id",
    "app_id",
    "installation_id",
    "kind",
    "prior_record_digest",
    "prior_generation",
    "prior_state",
    "target_state",
    "next_state",
    "stage",
    "completed_stages",
    "compensations",
    "status",
    "commit_outcome",
    "recovery",
    "started_at",
    "updated_at",
    "completed_at",
    "result",
    "error_code"
  ],
  "additionalProperties": false
}
