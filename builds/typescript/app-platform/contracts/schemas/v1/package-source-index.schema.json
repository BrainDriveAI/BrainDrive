{
  "$id": "https://schemas.braindrive.ai/resume-builder/v1/package-source-index.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "payload": {
      "type": "object",
      "properties": {
        "index_version": {
          "type": "number",
          "const": 1
        },
        "sequence": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "prior_index_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "published_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "entries": {
          "minItems": 1,
          "maxItems": 1000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "app_id": {
                "type": "string",
                "const": "ai.braindrive.resume-builder"
              },
              "publisher_id": {
                "type": "string",
                "const": "ai.braindrive"
              },
              "package_version": {
                "type": "string",
                "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$"
              },
              "descriptor_digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "archive_digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "targets": {
                "minItems": 2,
                "maxItems": 3,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "docker_linux_x64",
                    "desktop_windows_x64",
                    "desktop_macos_universal"
                  ]
                }
              },
              "sources": {
                "minItems": 2,
                "maxItems": 3,
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "environment": {
                          "type": "string",
                          "const": "docker_dev"
                        },
                        "kind": {
                          "type": "string",
                          "const": "repository_fixture"
                        },
                        "descriptor_fixture_id": {
                          "type": "string",
                          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
                        },
                        "archive_fixture_id": {
                          "type": "string",
                          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
                        }
                      },
                      "required": [
                        "environment",
                        "kind",
                        "descriptor_fixture_id",
                        "archive_fixture_id"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "environment": {
                          "type": "string",
                          "const": "desktop_windows"
                        },
                        "kind": {
                          "type": "string",
                          "const": "release_https"
                        },
                        "descriptor_url": {
                          "type": "string",
                          "format": "uri"
                        },
                        "archive_url": {
                          "type": "string",
                          "format": "uri"
                        }
                      },
                      "required": [
                        "environment",
                        "kind",
                        "descriptor_url",
                        "archive_url"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "environment": {
                          "type": "string",
                          "const": "desktop_macos"
                        },
                        "kind": {
                          "type": "string",
                          "const": "release_https"
                        },
                        "descriptor_url": {
                          "type": "string",
                          "format": "uri"
                        },
                        "archive_url": {
                          "type": "string",
                          "format": "uri"
                        }
                      },
                      "required": [
                        "environment",
                        "kind",
                        "descriptor_url",
                        "archive_url"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              }
            },
            "required": [
              "app_id",
              "publisher_id",
              "package_version",
              "descriptor_digest",
              "archive_digest",
              "targets",
              "sources"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "index_version",
        "sequence",
        "prior_index_digest",
        "published_at",
        "entries"
      ],
      "additionalProperties": false
    },
    "signature": {
      "type": "object",
      "properties": {
        "signature_version": {
          "type": "number",
          "const": 1
        },
        "domain_separator": {
          "type": "string",
          "const": "BrainDrive-App-Source-Index-v1"
        },
        "canonicalization": {
          "type": "string",
          "const": "braindrive-canonical-json-v1"
        },
        "signature_algorithm": {
          "type": "string",
          "const": "ed25519"
        },
        "signing_key_id": {
          "type": "string",
          "pattern": "^braindrive-app-(?:root|release)-[A-Za-z0-9-]{4,64}$"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      },
      "required": [
        "signature_version",
        "domain_separator",
        "canonicalization",
        "signature_algorithm",
        "signing_key_id",
        "signature"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "payload",
    "signature"
  ],
  "additionalProperties": false
}
