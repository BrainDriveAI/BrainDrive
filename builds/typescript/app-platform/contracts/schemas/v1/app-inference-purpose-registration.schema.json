{
  "$id": "https://schemas.braindrive.ai/app-platform/v1/app-inference-purpose-registration.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "registration_version": {
      "type": "number",
      "const": 1
    },
    "app_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
    },
    "key": {
      "type": "object",
      "properties": {
        "purpose_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)*$"
        },
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 65535
        }
      },
      "required": [
        "purpose_id",
        "version"
      ],
      "additionalProperties": false
    },
    "binding_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "input_schema_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)*$"
    },
    "output_schema_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)*$"
    },
    "prompt_policy_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "model_compatibility_class": {
      "type": "string",
      "const": "owner_active_compatible"
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_input_bytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 1048576
        },
        "max_input_tokens": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 262144
        },
        "max_output_tokens": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 16384
        },
        "max_duration_ms": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 120000
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        }
      },
      "required": [
        "max_input_bytes",
        "max_input_tokens",
        "max_output_tokens",
        "max_duration_ms",
        "max_attempts"
      ],
      "additionalProperties": false
    },
    "validation_policy_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "retry_policy": {
      "type": "string",
      "const": "same_snapshot_only"
    },
    "cancellation_policy": {
      "type": "string",
      "const": "required"
    },
    "audit_projection_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "owner_component_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    }
  },
  "required": [
    "registration_version",
    "app_id",
    "key",
    "binding_id",
    "input_schema_id",
    "output_schema_id",
    "prompt_policy_id",
    "model_compatibility_class",
    "limits",
    "validation_policy_id",
    "retry_policy",
    "cancellation_policy",
    "audit_projection_id",
    "owner_component_id"
  ],
  "additionalProperties": false
}
