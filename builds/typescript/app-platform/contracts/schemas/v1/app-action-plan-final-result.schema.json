{
  "$id": "https://schemas.braindrive.ai/resume-builder/v1/app-action-plan-final-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "step_result"
        },
        "step_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]*$"
        }
      },
      "required": [
        "kind",
        "step_id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "literal"
        },
        "value": {}
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    }
  ]
}
