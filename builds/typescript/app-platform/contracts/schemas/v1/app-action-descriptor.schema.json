{
  "$id": "https://schemas.braindrive.ai/app-platform/v1/app-action-descriptor.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "action_version": {
      "type": "number",
      "const": 1
    },
    "action_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "read",
        "write",
        "render",
        "export",
        "recover",
        "inspect"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "input_schema": {
      "type": "object",
      "properties": {
        "schema_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)*$"
        },
        "schema_version": {
          "type": "number",
          "const": 1
        },
        "content_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "schema": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "object"
            },
            "additionalProperties": {
              "type": "boolean",
              "const": false
            },
            "properties": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "additionalProperties": {
                "$ref": "#/$defs/__schema0"
              }
            },
            "required": {
              "maxItems": 128,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "description": {
              "type": "string",
              "maxLength": 4096
            }
          },
          "required": [
            "type",
            "additionalProperties",
            "properties",
            "required"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_id",
        "schema_version",
        "content_digest",
        "schema"
      ],
      "additionalProperties": false
    },
    "result_schema": {
      "type": "object",
      "properties": {
        "schema_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)*$"
        },
        "schema_version": {
          "type": "number",
          "const": 1
        },
        "content_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "schema": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "object"
            },
            "additionalProperties": {
              "type": "boolean",
              "const": false
            },
            "properties": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "additionalProperties": {
                "$ref": "#/$defs/__schema0"
              }
            },
            "required": {
              "maxItems": 128,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "description": {
              "type": "string",
              "maxLength": 4096
            }
          },
          "required": [
            "type",
            "additionalProperties",
            "properties",
            "required"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_id",
        "schema_version",
        "content_digest",
        "schema"
      ],
      "additionalProperties": false
    },
    "confirmation": {
      "type": "string",
      "enum": [
        "none",
        "owner_confirmation",
        "trusted_owner_confirmation"
      ]
    },
    "idempotency_policy": {
      "type": "string",
      "enum": [
        "not_applicable",
        "optional",
        "required"
      ]
    },
    "model_exposure": {
      "type": "string",
      "enum": [
        "hidden",
        "available"
      ]
    },
    "required_capabilities": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)*$"
          },
          "version": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 65535
          }
        },
        "required": [
          "name",
          "version"
        ],
        "additionalProperties": false
      }
    },
    "required_inference_purposes": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "purpose_id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)*$"
          },
          "version": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 65535
          }
        },
        "required": [
          "purpose_id",
          "version"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "action_version",
    "action_id",
    "kind",
    "title",
    "description",
    "input_schema",
    "result_schema",
    "confirmation",
    "idempotency_policy",
    "model_exposure",
    "required_capabilities",
    "required_inference_purposes"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "type": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "null",
                "boolean",
                "object",
                "array",
                "number",
                "integer",
                "string"
              ]
            },
            {
              "minItems": 1,
              "maxItems": 8,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "null",
                  "boolean",
                  "object",
                  "array",
                  "number",
                  "integer",
                  "string"
                ]
              }
            }
          ]
        },
        "additionalProperties": {
          "type": "boolean"
        },
        "properties": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "required": {
          "maxItems": 128,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "items": {
          "$ref": "#/$defs/__schema0"
        },
        "const": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 4096
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "enum": {
          "minItems": 1,
          "maxItems": 128,
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4096
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "minLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "format": {
          "type": "string",
          "const": "uuid"
        },
        "minItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "maxItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "description": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "additionalProperties": false
    }
  }
}
