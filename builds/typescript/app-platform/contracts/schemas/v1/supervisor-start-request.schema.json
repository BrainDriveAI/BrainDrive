{
  "$id": "https://schemas.braindrive.ai/resume-builder/v1/supervisor-start-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "supervisor_protocol_version": {
      "type": "number",
      "const": 1
    },
    "operation_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "runtime_role": {
      "type": "string",
      "enum": [
        "active",
        "candidate"
      ]
    },
    "descriptor": {
      "type": "object",
      "properties": {
        "supervisor_protocol_version": {
          "type": "number",
          "const": 1
        },
        "runtime_kind": {
          "type": "string",
          "enum": [
            "container",
            "packaged_node"
          ]
        },
        "app_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
        },
        "installation_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "package_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "grant_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "verified_entrypoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "arguments": {
          "type": "array",
          "prefixItems": []
        },
        "environment_keys": {
          "minItems": 1,
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "BRAINDRIVE_APP_CONNECTION_TOKEN",
              "BRAINDRIVE_APP_ID",
              "BRAINDRIVE_INSTALLATION_ID",
              "BRAINDRIVE_PACKAGE_DIGEST",
              "BRAINDRIVE_ENDPOINT_BIND"
            ]
          }
        },
        "package_root_ref": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "cache_root_ref": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "endpoint_policy": {
          "type": "object",
          "properties": {
            "transport": {
              "type": "string",
              "enum": [
                "container_internal",
                "loopback"
              ]
            },
            "authentication": {
              "type": "string",
              "const": "per_installation_token"
            },
            "public_bind_allowed": {
              "type": "boolean",
              "const": false
            }
          },
          "required": [
            "transport",
            "authentication",
            "public_bind_allowed"
          ],
          "additionalProperties": false
        },
        "resource_policy_version": {
          "type": "number",
          "const": 1
        }
      },
      "required": [
        "supervisor_protocol_version",
        "runtime_kind",
        "app_id",
        "installation_id",
        "package_digest",
        "grant_id",
        "verified_entrypoint",
        "arguments",
        "environment_keys",
        "package_root_ref",
        "cache_root_ref",
        "endpoint_policy",
        "resource_policy_version"
      ],
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "properties": {
        "policy_version": {
          "type": "number",
          "const": 1
        },
        "isolation": {
          "type": "string",
          "const": "one_process_or_container_per_active_installation"
        },
        "max_cpu_cores": {
          "type": "number",
          "const": 1
        },
        "max_memory_bytes": {
          "type": "number",
          "const": 536870912
        },
        "max_output_bytes_per_request": {
          "type": "number",
          "const": 1048576
        },
        "request_timeout_ms": {
          "type": "number",
          "const": 120000
        },
        "startup_timeout_ms": {
          "type": "number",
          "const": 30000
        },
        "max_crash_restarts": {
          "type": "number",
          "const": 3
        },
        "restart_backoff_ms": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "const": 1000
            },
            {
              "type": "number",
              "const": 2000
            },
            {
              "type": "number",
              "const": 4000
            }
          ]
        },
        "after_restart_limit": {
          "type": "string",
          "const": "owner_retry_required"
        },
        "public_bind_allowed": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "policy_version",
        "isolation",
        "max_cpu_cores",
        "max_memory_bytes",
        "max_output_bytes_per_request",
        "request_timeout_ms",
        "startup_timeout_ms",
        "max_crash_restarts",
        "restart_backoff_ms",
        "after_restart_limit",
        "public_bind_allowed"
      ],
      "additionalProperties": false
    },
    "requested_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "supervisor_protocol_version",
    "operation_id",
    "descriptor",
    "policy",
    "requested_at"
  ],
  "additionalProperties": false
}
