{
  "$id": "https://schemas.braindrive.ai/resume-builder/v1/spec-05-foundation-bundle.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "foundation_version": {
      "type": "number",
      "const": 1
    },
    "dependencies": {
      "type": "object",
      "properties": {
        "profile_version": {
          "type": "number",
          "const": 1
        },
        "modern_client": {
          "type": "string",
          "const": "@modelcontextprotocol/client@2.0.0"
        },
        "modern_core": {
          "type": "string",
          "const": "@modelcontextprotocol/core@2.0.0"
        },
        "fake_peer_server": {
          "type": "string",
          "const": "@modelcontextprotocol/server@2.0.0"
        },
        "node_transport": {
          "type": "string",
          "const": "@modelcontextprotocol/node@2.0.0"
        },
        "legacy_sdk": {
          "type": "string",
          "const": "@modelcontextprotocol/sdk@1.30.0"
        },
        "apps_sdk": {
          "type": "string",
          "const": "@modelcontextprotocol/ext-apps@1.7.5"
        },
        "conformance": {
          "type": "string",
          "const": "@modelcontextprotocol/conformance@0.2.0-alpha.11"
        },
        "runtime_node": {
          "type": "string",
          "const": ">=20"
        },
        "conformance_cli_node": {
          "type": "string",
          "const": ">=22"
        }
      },
      "required": [
        "profile_version",
        "modern_client",
        "modern_core",
        "fake_peer_server",
        "node_transport",
        "legacy_sdk",
        "apps_sdk",
        "conformance",
        "runtime_node",
        "conformance_cli_node"
      ],
      "additionalProperties": false
    },
    "protocols": {
      "type": "array",
      "prefixItems": [
        {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "profile_version": {
                  "type": "number",
                  "const": 1
                },
                "era": {
                  "type": "string",
                  "const": "modern_stateless"
                },
                "protocol_version": {
                  "type": "string",
                  "const": "2026-07-28"
                },
                "negotiation": {
                  "type": "string",
                  "const": "version_negotiation_and_optional_server_discover"
                },
                "session_header": {
                  "type": "boolean",
                  "const": false
                },
                "required_methods": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "string",
                      "const": "tools/list"
                    },
                    {
                      "type": "string",
                      "const": "tools/call"
                    },
                    {
                      "type": "string",
                      "const": "resources/list"
                    },
                    {
                      "type": "string",
                      "const": "resources/templates/list"
                    },
                    {
                      "type": "string",
                      "const": "resources/read"
                    }
                  ]
                },
                "apps": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "const": "io.modelcontextprotocol/ui"
                    },
                    "version": {
                      "type": "string",
                      "const": "2026-01-26"
                    }
                  },
                  "required": [
                    "id",
                    "version"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "profile_version",
                "era",
                "protocol_version",
                "negotiation",
                "session_header",
                "required_methods",
                "apps"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "profile_version": {
                  "type": "number",
                  "const": 1
                },
                "era": {
                  "type": "string",
                  "const": "bounded_legacy_stateful"
                },
                "protocol_version": {
                  "type": "string",
                  "const": "2025-11-25"
                },
                "negotiation": {
                  "type": "string",
                  "const": "initialize_initialized"
                },
                "session_header": {
                  "type": "boolean",
                  "const": true
                },
                "required_methods": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "string",
                      "const": "tools/list"
                    },
                    {
                      "type": "string",
                      "const": "tools/call"
                    }
                  ]
                },
                "apps": {
                  "type": "null",
                  "const": null
                }
              },
              "required": [
                "profile_version",
                "era",
                "protocol_version",
                "negotiation",
                "session_header",
                "required_methods",
                "apps"
              ],
              "additionalProperties": false
            }
          ]
        },
        {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "profile_version": {
                  "type": "number",
                  "const": 1
                },
                "era": {
                  "type": "string",
                  "const": "modern_stateless"
                },
                "protocol_version": {
                  "type": "string",
                  "const": "2026-07-28"
                },
                "negotiation": {
                  "type": "string",
                  "const": "version_negotiation_and_optional_server_discover"
                },
                "session_header": {
                  "type": "boolean",
                  "const": false
                },
                "required_methods": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "string",
                      "const": "tools/list"
                    },
                    {
                      "type": "string",
                      "const": "tools/call"
                    },
                    {
                      "type": "string",
                      "const": "resources/list"
                    },
                    {
                      "type": "string",
                      "const": "resources/templates/list"
                    },
                    {
                      "type": "string",
                      "const": "resources/read"
                    }
                  ]
                },
                "apps": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "const": "io.modelcontextprotocol/ui"
                    },
                    "version": {
                      "type": "string",
                      "const": "2026-01-26"
                    }
                  },
                  "required": [
                    "id",
                    "version"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "profile_version",
                "era",
                "protocol_version",
                "negotiation",
                "session_header",
                "required_methods",
                "apps"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "profile_version": {
                  "type": "number",
                  "const": 1
                },
                "era": {
                  "type": "string",
                  "const": "bounded_legacy_stateful"
                },
                "protocol_version": {
                  "type": "string",
                  "const": "2025-11-25"
                },
                "negotiation": {
                  "type": "string",
                  "const": "initialize_initialized"
                },
                "session_header": {
                  "type": "boolean",
                  "const": true
                },
                "required_methods": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "string",
                      "const": "tools/list"
                    },
                    {
                      "type": "string",
                      "const": "tools/call"
                    }
                  ]
                },
                "apps": {
                  "type": "null",
                  "const": null
                }
              },
              "required": [
                "profile_version",
                "era",
                "protocol_version",
                "negotiation",
                "session_header",
                "required_methods",
                "apps"
              ],
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "supervisor_policy": {
      "type": "object",
      "properties": {
        "policy_version": {
          "type": "number",
          "const": 1
        },
        "isolation": {
          "type": "string",
          "const": "one_process_or_container_per_active_installation"
        },
        "max_cpu_cores": {
          "type": "number",
          "const": 1
        },
        "max_memory_bytes": {
          "type": "number",
          "const": 536870912
        },
        "max_output_bytes_per_request": {
          "type": "number",
          "const": 1048576
        },
        "request_timeout_ms": {
          "type": "number",
          "const": 120000
        },
        "startup_timeout_ms": {
          "type": "number",
          "const": 30000
        },
        "max_crash_restarts": {
          "type": "number",
          "const": 3
        },
        "restart_backoff_ms": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "const": 1000
            },
            {
              "type": "number",
              "const": 2000
            },
            {
              "type": "number",
              "const": 4000
            }
          ]
        },
        "after_restart_limit": {
          "type": "string",
          "const": "owner_retry_required"
        },
        "public_bind_allowed": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "policy_version",
        "isolation",
        "max_cpu_cores",
        "max_memory_bytes",
        "max_output_bytes_per_request",
        "request_timeout_ms",
        "startup_timeout_ms",
        "max_crash_restarts",
        "restart_backoff_ms",
        "after_restart_limit",
        "public_bind_allowed"
      ],
      "additionalProperties": false
