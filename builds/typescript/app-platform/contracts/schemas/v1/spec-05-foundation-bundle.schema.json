    "renderer": {
      "type": "string",
      "const": "dedicated_web_client_double_iframe_proxy_no_tauri_authority"
    },
    "desktop_executable": {
      "type": "string",
      "const": "verified_compiled_javascript_on_braindrive_packaged_node"
    },
    "release_targets": {
      "type": "object",
      "properties": {
        "docker_dev": {
          "type": "string",
          "const": "required"
        },
        "windows": {
          "type": "string",
          "const": "first_packaged_claim"
        },
        "macos": {
          "type": "string",
          "const": "configured_unclaimed"
        },
        "linux": {
          "type": "string",
          "const": "configured_unclaimed"
        }
      },
      "required": [
        "docker_dev",
        "windows",
        "macos",
        "linux"
      ],
      "additionalProperties": false
    },
    "optional_facilities": {
      "type": "object",
      "properties": {
        "sampling": {
          "type": "string",
          "const": "rejected"
        },
        "prompts_completions": {
          "type": "string",
          "const": "deferred"
        },
        "remote_oauth": {
          "type": "string",
          "const": "deferred"
        },
        "stdio": {
          "type": "string",
          "const": "deferred"
        },
        "subscriptions": {
          "type": "string",
          "const": "deferred"
        },
        "tasks": {
          "type": "string",
          "const": "deferred"
        },
        "elicitation": {
          "type": "string",
          "const": "deferred"
        }
      },
      "required": [
        "sampling",
        "prompts_completions",
        "remote_oauth",
        "stdio",
        "subscriptions",
        "tasks",
        "elicitation"
      ],
      "additionalProperties": false
    }
