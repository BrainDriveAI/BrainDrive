{
  "$id": "https://schemas.braindrive.ai/resume-builder/v1/inference-result-tailoring-plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "plan_version": {
      "type": "number",
      "const": 2
    },
    "threshold_policy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "threshold_policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "fit_class": {
      "type": "string",
      "enum": [
        "meaningfully_supported",
        "partially_supported_transferable",
        "lacking_supported_core_fit"
      ]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "targeted_variant",
        "no_meaningful_change"
      ]
    },
    "no_change_reason": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "ambiguous_evidence",
            "insufficient_supported_fit",
            "no_material_resume_change"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "support_counts": {
      "type": "object",
      "properties": {
        "core": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "transferable": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "partial": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unsupported": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "core",
        "transferable",
        "partial",
        "unsupported"
      ],
      "additionalProperties": false
    },
    "changes": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "change_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "requirement_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "statement_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              {
                "type": "null"
              }
            ]
          },
          "action": {
            "type": "string",
            "enum": [
              "selection",
              "ordering",
              "emphasis",
              "faithful_wording",
              "shorten"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "supporting_confirmed_fact_revision_ids": {
            "minItems": 1,
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          }
        },
        "required": [
          "change_id",
          "requirement_id",
          "statement_id",
          "action",
          "rationale",
          "supporting_confirmed_fact_revision_ids"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "plan_version",
    "threshold_policy_id",
    "threshold_policy_version",
    "fit_class",
    "outcome",
    "no_change_reason",
    "support_counts",
    "changes"
  ],
  "additionalProperties": false
}
