{
  "$id": "https://schemas.braindrive.ai/app-platform/v1/package-component-configuration.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "configuration_version": {
      "type": "number",
      "const": 1
    },
    "non_secret_settings_schema": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "schema_id": {
              "type": "string",
              "minLength": 3,
              "maxLength": 128,
              "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)*$"
            },
            "schema_version": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 65535
            },
            "content_digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "required": [
            "schema_id",
            "schema_version",
            "content_digest"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "secrets": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "secret_id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
          },
          "required": {
            "type": "boolean"
          },
          "storage": {
            "type": "string",
            "const": "braindrive_vault_reference"
          },
          "runtime_delivery": {
            "type": "string",
            "const": "scoped_runtime_injection"
          },
          "consumer_projection": {
            "type": "string",
            "const": "never"
          }
        },
        "required": [
          "secret_id",
          "required",
          "storage",
          "runtime_delivery",
          "consumer_projection"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "configuration_version",
    "non_secret_settings_schema",
    "secrets"
  ],
  "additionalProperties": false
}
