{
  "$id": "https://schemas.braindrive.ai/resume-builder/v1/lifecycle-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "result_version": {
      "type": "number",
      "const": 1
    },
    "outcome": {
      "type": "string",
      "enum": [
        "committed",
        "no_change",
        "rolled_back",
        "quarantined",
        "failed_recoverable"
      ]
    },
    "final_state": {
      "type": "string",
      "enum": [
        "not_installed",
        "staged",
        "active",
        "disabled",
        "updating",
        "rollback_pending",
        "uninstalling",
        "quarantined",
        "failed_recoverable"
      ]
    },
    "final_generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "active_package_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "retained_last_known_good_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "runtime_authority_removed": {
      "type": "boolean"
    },
    "owner_data_preserved": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "result_version",
    "outcome",
    "final_state",
    "final_generation",
    "active_package_digest",
    "retained_last_known_good_digest",
    "runtime_authority_removed",
    "owner_data_preserved"
  ],
  "additionalProperties": false
}
