{
  "$id": "https://schemas.braindrive.ai/resume-builder/v1/capability-diff.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "diff_version": {
      "type": "number",
      "const": 1
    },
    "prior_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "career.context.read",
          "career.facts.read",
          "career.facts.propose",
          "career.facts.confirm",
          "resume.definitions.read",
          "resume.definitions.write",
          "resume.jobs.read",
          "resume.jobs.write",
          "resume.artifacts.register",
          "resume.export.request",
          "resume.operations.read",
          "app.inference.request"
        ]
      }
    },
    "requested_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "career.context.read",
          "career.facts.read",
          "career.facts.propose",
          "career.facts.confirm",
          "resume.definitions.read",
          "resume.definitions.write",
          "resume.jobs.read",
          "resume.jobs.write",
          "resume.artifacts.register",
          "resume.export.request",
          "resume.operations.read",
          "app.inference.request"
        ]
      }
    },
    "added": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "career.context.read",
          "career.facts.read",
          "career.facts.propose",
          "career.facts.confirm",
          "resume.definitions.read",
          "resume.definitions.write",
          "resume.jobs.read",
          "resume.jobs.write",
          "resume.artifacts.register",
          "resume.export.request",
          "resume.operations.read",
          "app.inference.request"
        ]
      }
    },
    "removed": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "career.context.read",
          "career.facts.read",
          "career.facts.propose",
          "career.facts.confirm",
          "resume.definitions.read",
          "resume.definitions.write",
          "resume.jobs.read",
          "resume.jobs.write",
          "resume.artifacts.register",
          "resume.export.request",
          "resume.operations.read",
          "app.inference.request"
        ]
      }
    },
    "unchanged": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "career.context.read",
          "career.facts.read",
          "career.facts.propose",
          "career.facts.confirm",
          "resume.definitions.read",
          "resume.definitions.write",
          "resume.jobs.read",
          "resume.jobs.write",
          "resume.artifacts.register",
          "resume.export.request",
          "resume.operations.read",
          "app.inference.request"
        ]
      }
    },
    "decision": {
      "type": "string",
      "enum": [
        "no_change",
        "narrowing_allowed",
        "owner_approval_required"
      ]
    }
  },
  "required": [
    "diff_version",
    "prior_capabilities",
    "requested_capabilities",
    "added",
    "removed",
    "unchanged",
    "decision"
  ],
  "additionalProperties": false
}
