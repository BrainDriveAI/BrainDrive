{
  "$id": "https://schemas.braindrive.ai/resume-builder/v1/inference-result-resume-strategy.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "strategy_version": {
      "type": "number",
      "const": 1
    },
    "history_shape": {
      "type": "string",
      "enum": [
        "chronological_standard",
        "early_career",
        "senior_selective",
        "career_change",
        "return_to_work",
        "concurrent_roles"
      ]
    },
    "history_reason_code": {
      "type": "string",
      "enum": [
        "standard_chronology",
        "thin_history",
        "senior_compression",
        "career_transition",
        "employment_gap",
        "overlap_or_promotion"
      ]
    },
    "role_emphasis": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "job_fact_revision_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "priority": {
            "type": "string",
            "enum": [
              "primary",
              "supporting",
              "compressed"
            ]
          },
          "reason_code": {
            "type": "string",
            "enum": [
              "recent",
              "relevant",
              "evidence_rich",
              "continuity",
              "older_context"
            ]
          },
          "bullet_density": {
            "type": "string",
            "enum": [
              "none",
              "compact",
              "standard",
              "expanded"
            ]
          }
        },
        "required": [
          "job_fact_revision_id",
          "priority",
          "reason_code",
          "bullet_density"
        ],
        "additionalProperties": false
      }
    },
    "section_order": {
      "minItems": 1,
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "evidence_priorities": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fact_revision_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "priority": {
            "type": "string",
            "enum": [
              "must_use",
              "preferred",
              "context"
            ]
          }
        },
        "required": [
          "fact_revision_id",
          "priority"
        ],
        "additionalProperties": false
      }
    },
    "summary_decision": {
      "type": "string",
      "enum": [
        "include",
        "omit"
      ]
    },
    "summary_reason_code": {
      "type": "string",
      "enum": [
        "supported_positioning",
        "insufficient_distinct_value",
        "redundant_with_experience"
      ]
    },
    "skills_context": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "skill_fact_revision_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "placement": {
            "type": "string",
            "enum": [
              "role",
              "project",
              "skills_section"
            ]
          },
          "context_fact_revision_ids": {
            "maxItems": 16,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          }
        },
        "required": [
          "skill_fact_revision_id",
          "placement",
          "context_fact_revision_ids"
        ],
        "additionalProperties": false
      }
    },
    "omissions": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fact_revision_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "reason_code": {
            "type": "string",
            "enum": [
              "redundant",
              "low_relevance",
              "space",
              "older_context",
              "owner_direction",
              "structural_mismatch",
              "conflict"
            ]
          }
        },
        "required": [
          "fact_revision_id",
          "reason_code"
        ],
        "additionalProperties": false
      }
    },
    "unresolved_gap_ids": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      }
    },
    "owner_rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    }
  },
  "required": [
    "strategy_version",
    "history_shape",
    "history_reason_code",
    "role_emphasis",
    "section_order",
    "evidence_priorities",
    "summary_decision",
    "summary_reason_code",
    "skills_context",
    "omissions",
    "unresolved_gap_ids",
    "owner_rationale"
  ],
  "additionalProperties": false
}
