{
  "$id": "https://schemas.braindrive.ai/resume-builder/v1/inference-result-requirement-evidence-match.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "evidence": {
      "minItems": 1,
      "maxItems": 250,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "requirement_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "evidence_status": {
            "type": "string",
            "enum": [
              "supported",
              "partially_supported",
              "unsupported",
              "ambiguous",
              "clarification_needed"
            ]
          },
          "supporting_confirmed_fact_revision_ids": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "clarification": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4096
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "requirement_id",
          "evidence_status",
          "supporting_confirmed_fact_revision_ids",
          "explanation",
          "clarification"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "evidence"
  ],
  "additionalProperties": false
}
