{
  "$id": "https://schemas.braindrive.ai/resume-builder/v1/inference-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "inference_schema_version": {
      "type": "number",
      "const": 1
    },
    "request_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "operation_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "purpose": {
      "type": "string",
      "enum": [
        "interview_assist",
        "general_resume_draft",
        "job_description_analyze",
        "requirement_evidence_match",
        "tailoring_plan",
        "targeted_resume_draft",
        "resume_revision_classify",
        "resume_revision_draft",
        "resume_guidance",
        "resume_strategy",
        "resume_craft_evaluate",
        "resume_craft_repair"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "accepted",
        "running",
        "completed",
        "cancelled",
        "deadline_exceeded",
        "rejected_incompatible",
        "failed"
      ]
    },
    "prompt_policy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "prompt_policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "output_schema_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "output_schema_version": {
      "type": "number",
      "const": 1
    },
    "input_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "output_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "result": {
      "anyOf": [
        {},
        {
          "type": "null"
        }
      ]
    },
    "provider_profile_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ]
    },
    "model_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ]
    },
    "attempt_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "usage": {
      "type": "object",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "input_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "output_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "available",
        "input_tokens",
        "output_tokens"
      ],
      "additionalProperties": false
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "invalid_request",
                "denied",
                "model_incompatible",
                "provider_unavailable",
                "quota_exceeded",
                "rate_limited",
                "deadline_exceeded",
                "cancelled",
                "schema_validation_failed",
                "validation_failed",
                "recoverable_internal_failure",
                "malformed_structured_output",
                "incomplete_output",
                "evidence_validation_failed",
                "provider_schema_unsupported",
                "provider_authentication_failed",
                "provider_authorization_failed",
                "content_filtered",
                "provider_refused",
                "unexpected_tool_call",
                "internal_failure"
              ]
            },
            "safe_message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "safe_message",
            "retryable"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "outcome": {
      "type": "object",
      "properties": {
        "stage": {
          "type": "string",
          "enum": [
            "request_validation",
            "compatibility_preflight",
            "provider_resolution",
            "provider_request",
            "finish_reason",
            "structured_parse",
            "output_schema_validation",
            "deterministic_validation",
            "recovery",
            "persistence",
            "cancellation",
            "completed",
            "internal"
          ]
        },
        "finish_category": {
          "type": "string",
          "enum": [
            "stop",
            "length",
            "content_filter",
            "refusal",
            "tool_calls",
            "unknown",
            "missing"
          ]
        },
        "attempt_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "retryable": {
          "type": "boolean"
        },
        "recovery_class": {
          "type": "string",
          "enum": [
            "none",
            "provider_structural_repair",
            "provider_validation_repair",
            "deterministic_fallback",
            "host_owned_zero_call"
          ]
        },
        "completion_mode": {
          "type": "string",
          "enum": [
            "none",
            "primary",
            "provider_repair",
            "deterministic_fallback",
            "host_owned"
          ]
        },
        "final_disposition": {
          "type": "string",
          "enum": [
            "completed",
            "failed",
            "cancelled"
          ]
        }
      },
      "required": [
        "stage",
        "finish_category",
        "attempt_count",
        "retryable",
        "recovery_class",
        "completion_mode",
        "final_disposition"
      ],
      "additionalProperties": false
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "completed_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "inference_schema_version",
    "request_id",
    "operation_id",
    "purpose",
    "status",
    "prompt_policy_id",
    "prompt_policy_version",
    "output_schema_id",
    "output_schema_version",
    "input_digest",
    "output_digest",
    "result",
    "provider_profile_id",
    "model_id",
    "attempt_count",
    "usage",
    "error",
    "started_at",
    "completed_at"
  ],
  "additionalProperties": false
}
