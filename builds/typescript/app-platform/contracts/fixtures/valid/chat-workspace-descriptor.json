      "max_bytes": 65536,
      "freshness_policy": "latest_available",
      "required_capabilities": [
        { "name": "career.context.read", "version": 1 }
      ]
    }
  ],
  "actions": [
    {
      "action_version": 1,
      "action_id": "resume.profile.update",
      "kind": "write",
      "title": "Update Profile",
      "description": "Request an app-owned source document update.",
