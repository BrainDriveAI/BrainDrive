{
  "name": "braindrive-client",
  "description": "BrainDrive web client",
  "private": true,
  "version": "26.7.23",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BrainDriveAI/braindrive.git",
    "directory": "builds/typescript/client_web"
  },
  "homepage": "https://braindrive.ai",
  "bugs": {
    "url": "https://github.com/BrainDriveAI/braindrive/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run test:e2e:mobile && node scripts/run-isolated-e2e.mjs --project=desktop-chrome",
    "test:e2e:mobile": "node scripts/run-isolated-e2e.mjs --project=mobile-chrome --project=mobile-safari",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.181",
    "@tauri-apps/api": "^2.12.5",
    "braindrive": "file:..",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.77.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.6",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.1",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^21.0.4",
    "jsdom": "^31.0.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.5"
  }
}
